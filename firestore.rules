rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Catch-All Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidMemory(data) {
      return data.keys().hasAll(['id', 'userId', 'coupleNames', 'imageDataUrl', 'layout', 'theme', 'createdAt'])
        && data.id is string && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$')
        && data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid
        && data.coupleNames is string && data.coupleNames.size() <= 150
        && data.imageDataUrl is string && data.imageDataUrl.size() <= 900000
        && data.layout in ['strip3', 'strip4', 'polaroid']
        && data.theme in ['blush', 'airmail', 'minimal', 'noir', 'lavender', 'champagne']
        && data.createdAt is number;
    }

    // Connection validation endpoint
    match /test/{docId} {
      allow read: if true;
    }

    // User couple memories collection
    match /users/{userId}/memories/{memoryId} {
      allow get: if isOwner(userId) && isValidId(memoryId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId)
                    && isValidId(memoryId)
                    && isValidMemory(request.resource.data);
      allow update: if isOwner(userId)
                    && isValidId(memoryId)
                    && isValidMemory(request.resource.data)
                    && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner(userId) && isValidId(memoryId);
    }
  }
}
